<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BotNexus.Extensions.Reference/BotNexus.Extensions.Reference.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(BotNexusReferenceShape)' == 'binary'">
    <Reference Include="BotNexus.Agent.Core" HintPath="$(BotNexusRepoRoot)/src/agent/BotNexus.Agent.Core/bin/$(BotNexusBinaryConfiguration)/net10.0/BotNexus.Agent.Core.dll" Private="true" />
    <Reference Include="BotNexus.Agent.Providers.Core" HintPath="$(BotNexusRepoRoot)/src/agent/BotNexus.Agent.Providers.Core/bin/$(BotNexusBinaryConfiguration)/net10.0/BotNexus.Agent.Providers.Core.dll" Private="true" />
  </ItemGroup>
</Project>
